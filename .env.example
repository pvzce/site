# make run reads this file after it has been copied to .env.
# Docker Compose also reads .env for variable interpolation.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576

# Optional for direct execution: set DATABASE_URL or DB_HOST to enable PostgreSQL.
# Compose always connects to its database service unless DATABASE_URL is set.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=pvzce
DB_USER=pvzce
# Set a random password before using Compose. Never commit .env.
DB_PASSWORD=
# The bundled database uses an isolated Docker network without TLS.
# Use verify-full for a managed / remote PostgreSQL instance.
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_CONNECT_TIMEOUT=5s
DB_QUERY_TIMEOUT=3s
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=5m

# Internal file reader only; no public file endpoint is registered.
DATA_DIR=./data
CONFIG_DIR=./configs
CACHE_DIR=./cache
FILE_MAX_BYTES=16777216

# Compose publishes to loopback by default. Set HOST=0.0.0.0 for public binding.
HOST=127.0.0.1
PORT=8080
VERSION=dev

# make auth-init generates the client secret and local bootstrap credentials.
AUTH_ENABLED=false
APP_PUBLIC_URL=http://localhost:8080
CASDOOR_ISSUER_URL=http://localhost:8000
# For host-side development leave this empty; Compose uses http://casdoor:8000.
CASDOOR_INTERNAL_URL=
CASDOOR_APPLICATION=pvzce-site
CASDOOR_CLIENT_ID=pvzce-site
CASDOOR_CLIENT_SECRET=
AUTH_SESSION_TTL=24h
CASDOOR_PORT=8000

# Workshop uploads: byte units, shared account AND source-IP limits per UTC day.
UPLOAD_MAX_FILE_BYTES=209715200
UPLOAD_DAILY_QUOTA_BYTES=524288000
UPLOAD_QUOTA_TIMEZONE=UTC
UPLOAD_TEMP_DIR=./cache/uploads
# Only explicitly controlled reverse proxy CIDRs may supply X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
# Run python3 scripts/init-workshop.py for local credentials, or configure private S3.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SECURE=true
DOWNLOAD_HASH_KEY=
CLAMD_ADDRESS=

# Optional classification-only moderation adapter. Empty means manual pending, never auto-approved.
# No provider/jev endpoint or credential is assumed. See docs/community.md for the strict contract.
MODERATION_ENDPOINT=
MODERATION_API_KEY=
